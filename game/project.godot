; Last Shift — Godot 4.6.3, standard GDScript, Compatibility renderer.
config_version=5

[application]
config/name="Last Shift"
config/version="0.2.1"
run/main_scene="res://scenes/ship.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.06, 1)

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
drop={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77)]
}
work_mode={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":84)]
}
dev_reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
dev_log={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194341)]
}

dev_overlay={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194339)]
}
dev_ready={
